datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MEMBER
  BACKUP_ADMIN
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_UNION
  CREDIT_CARD
  DEBIT_CARD
  PAYPAL
  LOAN
  INVESTMENT
  OTHER
}

enum StatementTxStatus {
  UNMATCHED
  MATCHED
  IGNORED
  // Auto-flagged at import time: matches a transaction already imported from
  // an earlier statement (same date/amount/description) — most likely an
  // overlapping statement period, not a new transaction. Kept out of "needs
  // review" by default so it isn't accidentally logged twice; reversible via
  // the same "reset" action as IGNORED.
  DUPLICATE
}

enum StatementTxDirection {
  DEBIT
  CREDIT
}

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugStatus {
  OPEN
  FIXED
}

model Household {
  id         String   @id @default(cuid())
  name       String   @default("Our Household")
  inviteCode String   @unique @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users     User[]
  expenses  Expense[]
  incomes   Income[]
  accounts  Account[]
  transfers Transfer[]
  goals     Goal[]

  statementImports      StatementImport[]
  statementTransactions StatementTransaction[]
  merchantAliases       MerchantAlias[]
  categories            Category[]
  databaseBackups       DatabaseBackup[]

  mapNodes MapNode[]
  mapEdges MapEdge[]

  bugReports BugReport[]

  budgets Budget[]

  auditLogs AuditLog[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(MEMBER)
  avatarUrl String?

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]
  incomes  Income[]
  sessions Session[]
  accountsCreated Account[]
  transfersCreated Transfer[]
  goalsCreated     Goal[]

  statementImportsCreated StatementImport[]
  categoriesCreated       Category[]

  mapNodesCreated MapNode[]

  bugReportsCreated BugReport[]

  budgetsCreated Budget[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Expense {
  id              String   @id @default(cuid())
  name            String
  vendor          String?
  amount          Float
  currency        String   @default("EUR")
  billingCycle    String   @default("monthly")
  category        String   @default("utilities")
  icon            String   @default("Zap")
  color           String   @default("#3155D9")
  renewalDay      Int      @default(1)
  nextRenewalDate String
  isPaidThisCycle Boolean  @default(false)
  lastPaidAt      DateTime?
  paymentMethod   String   @default("SEPA Direct Debit")
  isActive        Boolean  @default(true)
  isPending       Boolean  @default(false)
  notes           String?
  contractEndDate String?
  vendorEmail     String?
  usageRating     String?  @default("high")
  isVariable      Boolean  @default(false)
  // Whether this counts as a recurring bill/contract (shows in the Bills
  // tab) vs one-off/incidental spending (e.g. a coffee) that should only
  // show in the Spending ledger. Defaults true for backward compatibility
  // with existing recurring records.
  isBill          Boolean  @default(true)

  // Set only when this expense was created (or later edited) from a
  // receipt/bill scan where a live ECB rate was applied to convert a
  // foreign-currency amount into the household's currency — preserves what
  // was actually paid, since `amount`/`currency` above hold only the
  // converted figure. Purely informational (a caption on the expense), not
  // used in any total/aggregation.
  originalAmount   Float?
  originalCurrency String?
  exchangeRate     Float?
  rateDate         String?

  // Set when part of this expense's cost is expected to be reimbursed (e.g.
  // a health-insurance claim). reimbursementReceived is null while the claim
  // is pending; once set, spend totals count only (amount - reimbursementReceived)
  // for this expense — see getEffectiveAmount() in src/utils/calculations.ts.
  reimbursementExpected     Float?
  reimbursementReceived     Float?
  reimbursementReceivedDate String?

  householdId     String?
  household       Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdById     String?
  createdBy       User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  paymentAccountId String?
  paymentAccount    Account? @relation("ExpensePaymentAccount", fields: [paymentAccountId], references: [id], onDelete: SetNull)

  linkedGoalId String?
  linkedGoal   Goal?   @relation("ExpenseLinkedGoal", fields: [linkedGoalId], references: [id], onDelete: SetNull)

  // Set only when this Expense was created via statement-import resolution
  // ("Add as expense" / "recognize as recurring bill") — lets "Undo this
  // import" remove it as a unit. SetNull (not Cascade) so the ordinary
  // "delete import" action, which intentionally keeps already-logged
  // records, doesn't touch this.
  statementImportId String?
  statementImport   StatementImport? @relation("StatementImportExpenses", fields: [statementImportId], references: [id], onDelete: SetNull)

  transfers Transfer[]

  statementTransactions StatementTransaction[]
  merchantAliases       MerchantAlias[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([householdId])
  @@index([paymentAccountId])
  @@index([statementImportId])
}

model Income {
  id           String   @id @default(cuid())
  name         String
  amount       Float
  currency     String   @default("EUR")
  frequency    String   @default("monthly")
  nextPayDate  String?
  category     String   @default("salary")
  isActive     Boolean  @default(true)
  notes        String?
  // Mirrors Expense.isPaidThisCycle/lastPaidAt — lets a household mark
  // "money actually landed" for this cycle, which logs a dated Transfer
  // so real income history accumulates over time.
  isReceivedThisCycle Boolean   @default(false)
  lastReceivedAt      DateTime?

  householdId  String?
  household    Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdById  String?
  createdBy    User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  depositAccountId String?
  depositAccount    Account? @relation("IncomeDepositAccount", fields: [depositAccountId], references: [id], onDelete: SetNull)

  transfers Transfer[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([householdId])
  @@index([depositAccountId])
}

/// A financial account or payment method (bank, credit union, PayPal, credit
/// card, loan, etc). Sensitive fields (account/routing numbers, login
/// credentials, security notes) are stored AES-256-GCM encrypted at the
/// application layer (see src/lib/crypto.ts) — never in plaintext.
model Account {
  id          String      @id @default(cuid())
  name        String
  institution String?
  type        AccountType @default(OTHER)
  currency    String      @default("EUR")
  notes       String?
  isActive    Boolean     @default(true)

  // Manually entered/updated — this app has no live bank sync, so there is
  // no automatic way to know the real current balance. Null until the
  // household sets one.
  balance     Float?
  balanceAsOf String?

  // Encrypted sensitive fields (format: iv:authTag:ciphertext, base64) —
  // null when not set. Never selected in list/summary API responses.
  accountNumberEnc String?
  routingNumberEnc String?
  ibanEnc          String?
  bicEnc           String?
  loginUsernameEnc String?
  loginPasswordEnc String?
  loginUrlEnc      String?
  securityNotesEnc String?

  // Loan-specific (optional, plaintext — not secret on their own)
  originalAmount Float?
  interestRate   Float?
  termMonths     Int?
  payoffDate     String?

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  expenses Expense[] @relation("ExpensePaymentAccount")
  incomes  Income[]  @relation("IncomeDepositAccount")

  transfersOut Transfer[] @relation("TransferFromAccount")
  transfersIn  Transfer[] @relation("TransferToAccount")
  goals        Goal[]     @relation("GoalAccount")

  statementImports StatementImport[] @relation("StatementImportAccount")

  mapNodes MapNode[] @relation("MapNodeAccount")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

/// A single money-movement event — one hop in the "money journey". Either
/// side can be an internal Account, or left null to represent money
/// crossing the household boundary (e.g. salary landing, or a direct debit
/// going out to a vendor). Optionally linked to the recurring Expense/Income
/// record it corresponds to, so the recurring definition and the actual
/// dated movement stay connected.
model Transfer {
  id       String   @id @default(cuid())
  amount   Float
  currency String   @default("EUR")
  date     String
  note     String?

  // Free-text label for whichever side is external (fromAccountId/toAccountId
  // is null) — e.g. "Salary — Acme Corp" or "Netflix direct debit".
  externalLabel String?

  fromAccountId String?
  fromAccount   Account? @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: SetNull)

  toAccountId String?
  toAccount   Account? @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)

  linkedExpenseId String?
  linkedExpense   Expense? @relation(fields: [linkedExpenseId], references: [id], onDelete: SetNull)

  linkedIncomeId String?
  linkedIncome   Income?  @relation(fields: [linkedIncomeId], references: [id], onDelete: SetNull)

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  statementTransactions StatementTransaction[]

  // Same purpose as Expense.statementImportId above — lets "Undo this
  // import" remove every Transfer it created as a unit, without touching
  // ones created any other way.
  statementImportId String?
  statementImport   StatementImport? @relation("StatementImportTransfers", fields: [statementImportId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([date])
  @@index([statementImportId])
}

/// A savings/financial goal — optionally tied to an Account (e.g. a savings
/// pot), with a manually-tracked current amount and an optional target date.
model Goal {
  id            String   @id @default(cuid())
  name          String
  targetAmount  Float
  currentAmount Float    @default(0)
  currency      String   @default("EUR")
  targetDate    String?
  notes         String?
  isActive      Boolean  @default(true)

  linkedAccountId String?
  linkedAccount   Account? @relation("GoalAccount", fields: [linkedAccountId], references: [id], onDelete: SetNull)

  linkedExpenses Expense[] @relation("ExpenseLinkedGoal")

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}

/// A single upload of a bank/credit-card statement (CSV), used to cross-check
/// real-world transactions against the household's tracked Expenses/Transfers
/// to surface missed bills, forgotten subscriptions, and ad-hoc payments.
model StatementImport {
  id       String  @id @default(cuid())
  label    String
  fileName String?

  // Which of the household's Accounts this statement was exported from —
  // scopes automatic matching to expenses/transfers that touch that account.
  accountId String?
  account   Account? @relation("StatementImportAccount", fields: [accountId], references: [id], onDelete: SetNull)

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  transactions StatementTransaction[]

  expensesCreated  Expense[]  @relation("StatementImportExpenses")
  transfersCreated Transfer[] @relation("StatementImportTransfers")

  // Extracted from PDF/photo statements only (analyzeStatementDocument) —
  // CSV imports leave these null, since a CSV export has no such header.
  // The only available proof an import captured every row: if both
  // balances are present, closingBalance - openingBalance should equal the
  // sum of logged (non-ignored, non-duplicate) transaction amounts for
  // this import, surfaced as a reconciliation line in the UI.
  openingBalance  Float?
  closingBalance  Float?
  statementPeriod String?

  createdAt DateTime @default(now())

  @@index([householdId])
  @@index([accountId])
}

/// A single row from an imported statement, after normalization and an
/// attempt to automatically match it against existing Expenses/Transfers or
/// a learned MerchantAlias.
model StatementTransaction {
  id                    String                @id @default(cuid())
  date                  String
  rawDescription        String
  normalizedDescription String
  amount                Float
  currency              String                @default("EUR")
  direction             StatementTxDirection  @default(DEBIT)
  status                StatementTxStatus     @default(UNMATCHED)
  matchConfidence       Float?
  notes                 String?

  // A spending category inferred from a previously-learned MerchantAlias for
  // this description pattern, if any — used to pre-fill the category picker
  // when the household categorizes this row as a new one-off expense, so
  // repeat merchants get faster (and more consistent) categorization over time.
  suggestedCategory     String?

  // A friendly nickname for this merchant (e.g. "Smyths Toy Shop" for a raw
  // description of "IEPROS"), either learned from a previously-confirmed
  // MerchantAlias or set directly by the household via "Rename merchant".
  vendorName            String?

  importId String
  import   StatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  matchedExpenseId String?
  matchedExpense   Expense? @relation(fields: [matchedExpenseId], references: [id], onDelete: SetNull)

  matchedTransferId String?
  matchedTransfer   Transfer? @relation(fields: [matchedTransferId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([importId])
  @@index([matchedExpenseId])
  @@index([matchedTransferId])
  @@index([status])
}

/// A learned association between a normalized statement-description pattern
/// and a real vendor/expense, built up as the household confirms matches —
/// so cryptic statement references get recognized automatically next time.
model MerchantAlias {
  id         String   @id @default(cuid())
  pattern    String
  vendorName String
  category   String?
  matchCount Int      @default(1)

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  expenseId String?
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([householdId, pattern])
  @@index([householdId])
}

/// A household-defined spending category, in addition to the fixed built-in
/// set (Streaming, Utilities, etc — see src/data/categories.ts). Created
/// on the fly ("+ Create category") when nothing built-in fits (e.g. "Tolls").
/// Cached daily reference rate (against EUR) for one non-EUR currency Tally
/// supports. Global, not household-scoped — an exchange rate isn't private
/// household data. Refreshed lazily by GET /api/exchange-rate-cache when a
/// row is missing or older than 24h, so it self-heals without depending on
/// a cron having run. See src/utils/currencies.ts's updateLiveRates().
model ExchangeRate {
  currency  String   @id
  rateToEur Float
  updatedAt DateTime @updatedAt
}

model Category {
  id          String   @id @default(cuid())
  name        String
  icon        String   @default("Tag")
  color       String   @default("#676B73")
  bgColor     String   @default("#f1f2f4")
  borderColor String   @default("#e7e8ea")

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([householdId, name])
  @@index([householdId])
}

/// A household-set monthly spending limit for one category (built-in or
/// custom, matched by the same id/string used everywhere else — see
/// src/data/categories.ts). Deliberately simple: one static limit per
/// category, compared against that category's current monthly-equivalent
/// spend (the same figure Overview/Spending already show) — no rollover,
/// no history, no per-member budgets.
model Budget {
  id           String @id @default(cuid())
  category     String
  monthlyLimit Float
  currency     String @default("EUR")

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([householdId, category])
  @@index([householdId])
}

/// A plain, append-only activity trail for destructive and
/// identity-affecting actions — deliberately NOT full field-level diffing
/// on every edit (too much for a two/few-person household to need). Covers
/// deletions, backup restores, member removal, and role changes: the
/// things worth being able to answer "did that really happen, and who did
/// it" about. entityLabel is a short human-readable snapshot taken at the
/// time of the action (e.g. an expense's name right before it's deleted),
/// not a full before/after record.
model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityLabel String?

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  actorId   String?
  actorName String

  createdAt DateTime @default(now())

  @@index([householdId, createdAt])
}

/// Records a contract-reminder email already sent for a given expense +
/// days-out threshold, so a duplicate/overlapping cron invocation (retries,
/// manual re-trigger, etc.) can't send the same reminder twice.
model SentReminder {
  id         String   @id @default(cuid())
  expenseId  String
  threshold  Int
  sentOn     String
  createdAt  DateTime @default(now())

  @@unique([expenseId, threshold, sentOn])
  @@index([expenseId])
}

model DatabaseBackup {
  id          String   @id @default(cuid())
  createdById String?
  payloadJson Json
  recordCount Int
  notes       String?
  createdAt   DateTime @default(now())

  // True for snapshots created by the daily cron (see cron/backup route),
  // false for ones an admin triggered manually from Admin > Database
  // Snapshots. Automatic snapshots are pruned to the most recent 14 per
  // household; manual ones are deliberate checkpoints and never auto-pruned.
  isAutomatic Boolean @default(false)

  // Nullable so pre-existing rows created before this column was added
  // don't need a backfill — they simply stop being listed/restorable,
  // which is the safe (fail-closed) default for un-attributed backups.
  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

/// A freeform, user-positioned node on the editable "My map" canvas — either
/// linked to a real Account (auto-fills name/institution) or a standalone
/// custom label (e.g. "Car Loan — Credit Union") for things not yet tracked
/// as a full Account. Position (x, y) is user-dragged and persisted as-is.
model MapNode {
  id          String  @id @default(cuid())
  label       String
  kind        String  @default("CUSTOM") // 'ACCOUNT' | 'CUSTOM'
  color       String?
  x           Float   @default(0)
  y           Float   @default(0)

  accountId String?
  account   Account? @relation("MapNodeAccount", fields: [accountId], references: [id], onDelete: Cascade)

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  edgesFrom MapEdge[] @relation("MapEdgeFrom")
  edgesTo   MapEdge[] @relation("MapEdgeTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([accountId])
}

/// A directional connection drawn by the user between two MapNodes on the
/// custom map canvas — from -> to gives the arrow direction.
model MapEdge {
  id     String  @id @default(cuid())
  label  String?
  amount Float?
  currency String?

  fromNodeId String
  fromNode   MapNode @relation("MapEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId   String
  toNode     MapNode @relation("MapEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
  @@index([fromNodeId])
  @@index([toNodeId])
}

/// A user-logged bug/issue report, kept in-app so problems can be recorded
/// in the moment and later exported to Markdown for handing to an AI coding
/// tool or tracking in an external issue tracker.
model BugReport {
  id          String      @id @default(cuid())
  title       String
  description String?
  area        String?
  severity    BugSeverity @default(MEDIUM)
  status      BugStatus   @default(OPEN)

  householdId String?
  household   Household?  @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([householdId])
}
